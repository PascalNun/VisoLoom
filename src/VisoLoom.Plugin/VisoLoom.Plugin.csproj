<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Rhino 8 originally ships .NET 7; this assembly also loads in its later .NET 8 hosts. -->
    <TargetFramework>net7.0</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>VisoLoom</AssemblyName>
    <RootNamespace>VisoLoom.Plugin</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Rhino supplies these APIs and its compatible drawing implementation. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The original Rhino 8 SDK labels its build references net48. Rhino supplies the runtime assemblies. -->
    <PackageReference Include="RhinoCommon" ExcludeAssets="runtime" PrivateAssets="all" NoWarn="NU1701" />
    <PackageReference Include="System.Drawing.Common" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="../VisoLoom.Core/VisoLoom.Core.csproj" />
    <ProjectReference Include="../VisoLoom.Protocol/VisoLoom.Protocol.csproj" />
    <ProjectReference Include="../VisoLoom.Providers/VisoLoom.Providers.csproj" />
    <EmbeddedResource Include="Resources/VisoLoom.png" />
    <EmbeddedResource Include="../../examples/presets/*.json" LogicalName="VisoLoom.Presets.%(Filename).json" />
  </ItemGroup>
  <Target Name="RemoveHostRuntimeAssemblies" AfterTargets="Build">
    <ItemGroup>
      <HostRuntimeFile Include="$(TargetDir)RhinoCommon.*;$(TargetDir)Rhino.UI.*;$(TargetDir)Eto.*;$(TargetDir)System.Drawing.Common.*;$(TargetDir)runtimes/**/System.Drawing.Common.dll" />
    </ItemGroup>
    <Delete Files="@(HostRuntimeFile)" />
  </Target>
</Project>
